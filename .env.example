# Copy to .env.local and fill in. Every variable is optional — each
# integration no-ops when its variable is absent.

# Absolute site origin. Used for canonicals, the sitemap, RSS and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.autocropper.org

# GA4 measurement ID. Without it, gtag is never injected.
NEXT_PUBLIC_GA_ID=

# PostHog project API key. Without it, PostHog never initialises and every
# track() call is a no-op.
NEXT_PUBLIC_POSTHOG_KEY=phc_AaTFe5oeHEgbUEVk5kmjRzSRzsP3rhyGT6oWeBWuJtMx

# PostHog ingestion host. Optional — defaults to https://eu.i.posthog.com.
# Only set this if the project lives on US cloud or behind a proxy.
NEXT_PUBLIC_POSTHOG_HOST=
